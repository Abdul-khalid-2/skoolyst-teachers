# Copy this file to ".env" and fill in real values for your environment.
# ".env" itself is gitignored and must never be committed.

# ----- Environment -----
APP_ENV=production
APP_DEBUG=false

# Leave blank to auto-detect. Only set this if auto-detection is wrong for
# your setup (e.g. behind a reverse proxy/CDN that rewrites the host).
# FORCE_BASE_URL=https://teachers.skoolyst.com

# ----- Database -----
DB_HOST=localhost
DB_NAME=skoolyst_teachers
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ----- Mail (SMTP) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@skoolyst.com
MAIL_FROM_NAME="Skoolyst Teachers"

# ----- AdEngine (Skoolyst Ads) -----
# Get this from https://ads.skoolyst.com/admin/apps.php after registering
# this app there and defining a placement code for the landing page.
ADS_API_BASE=https://ads.skoolyst.com/api/v1
ADS_API_KEY=
ADS_PLACEMENT_HOME_TOP=teachers_home_top
