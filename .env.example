# Copy this file to ".env" and fill in real values for your environment.
# ".env" itself is gitignored and must never be committed.

# ----- Environment -----
APP_ENV=production
APP_DEBUG=false

# Leave blank to auto-detect. Only set this if auto-detection is wrong for
# your setup (e.g. behind a reverse proxy/CDN that rewrites the host).
# FORCE_BASE_URL=https://teachers.skoolyst.com

# ----- Database -----
DB_HOST=localhost
DB_NAME=skoolyst_teachers
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ----- Email (Skoolyst Email API) -----
# Key from https://ads.skoolyst.com -> Admin -> Email Accounts -> API Clients.
# EMAIL_SOURCE_APP must match the app name the key was issued for.
EMAIL_API_BASE=https://ads.skoolyst.com/api/v1
SKOOLYST_EMAIL_API_KEY=sk_mail_088abc9e212b4450e7959d7df8f319e4d27994cefe7a75b4
EMAIL_SOURCE_APP=skoolyst-teachers

# ----- Login with Skoolyst (SSO) -----
# From skoolyst.com -> Dashboard -> Connected Apps -> Add App. Register the
# redirect URL below there EXACTLY (protocol, host, path, no trailing slash).
SKOOLYST_AUTH_BASE=https://skoolyst.com
SKOOLYST_AUTH_CLIENT_ID=
SKOOLYST_AUTH_CLIENT_SECRET=
SKOOLYST_AUTH_REDIRECT_URI=https://teachers.skoolyst.com/auth/skoolyst/callback
# ----- Continue with Google -----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add <your site>/auth/google/callback under "Authorized
# redirect URIs" EXACTLY. GOOGLE_REDIRECT_URI defaults to that URL; set it
# only if the registered URL differs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ----- AdEngine (Skoolyst Ads) -----
# Get this from https://ads.skoolyst.com/admin/apps.php after registering
# this app there and defining a placement code for the landing page.
ADS_API_BASE=https://ads.skoolyst.com/api/v1
ADS_API_KEY=
ADS_PLACEMENT_HOME_TOP=teachers_home_top
